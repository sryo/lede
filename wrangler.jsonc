{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lede",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only the stats, the beacon, signing in and read-only links (/s/<token>) run the Worker. The
    // dashboard page and the tracker are plain assets: free, and the page asks for the password itself.
    "run_worker_first": ["/api/*", "/lede", "/s/*"],
    // Every view has its own address (/bounce, /sources/google.com…); those all load the dashboard.
    "not_found_handling": "single-page-application"
  },
  // Created on first write; the stats API queries it by this name.
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "lede" }],
  // Created on deploy. Keeps the sites, the monthly salts, the account ID, each site's goals, funnels and notes,
  // read-only links, and kept pictures and lines (see src/settings.js).
  "kv_namespaces": [{ "binding": "STORE" }],
  // "Here now" as it happens (src/live.js): one Durable Object per site, which pushes who is here to an open
  // dashboard. SQLite-backed, which the Free plan includes; it's only asked anything while a dashboard watches.
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "Live" }] },
  "migrations": [{ "tag": "live", "new_sqlite_classes": ["Live"] }],
  // Alerts (src/alerts.js): the week's story on Monday at 08:00 UTC, and a check for spikes every 15 minutes.
  // Both do nothing until ALERT_WEBHOOK is set.
  "triggers": { "crons": ["0 8 * * 1", "*/15 * * * *"] },
  // Optional: Workers AI writes the second line under home's sentence and the weekly message's (src/insight.js),
  // from the totals only. The Free plan gives 10,000 Neurons a day, about 500 of those lines; past that, or
  // with this removed, Lede works the same without them. `npm run dev` runs with --local, which leaves it out.
  "ai": { "binding": "AI" },
  // Workers Logs: what Lede says when something goes wrong (a query that failed, a webhook that didn't
  // answer), in the Cloudflare dashboard under Workers & Pages, lede, Observability. The line Cloudflare
  // adds for every request is left out, so page views don't use up the free plan's 200,000 log lines a day.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
  // Secrets, asked for by the deploy button (the first two) or set with `npx wrangler secret put <NAME>`:
  //   ANALYTICS_TOKEN     API token from the link in docs/how-it-works.md: reads the stats, finds the account, takes page pictures
  //   DASHBOARD_PASSWORD  protects the dashboard and stats API
  // Set only with `npx wrangler secret put ALERT_WEBHOOK`:
  //   ALERT_WEBHOOK       optional: a Slack, Discord or ntfy address that gets the weekly story and spikes
  // Optional vars:
  //   ACCOUNT_ID          only when the token reaches more than one account
  //   KEEP_DATACENTER     "true" counts visits from cloud and hosting networks (dropped by default)
  //   RESPECT_GPC         "true" leaves out browsers that send Global Privacy Control
  //   ALERTS              "weekly", "spikes" or "weekly,spikes" (the default) once ALERT_WEBHOOK is set
  //   DASHBOARD_URL       the dashboard's address for the links in alerts, when it isn't where you last signed in
  //   DATASET             the dataset the stats are read from, when you change its name above ("lede" by default)
  // Optional: Cloudflare's rate limiter, so the beacons from one address (src/collect.js) and the sign-in
  // tries (src/index.js) are also counted across Worker instances. Not on by default, since Cloudflare
  // doesn't say the Free plan includes it:
  //   "ratelimits": [{ "name": "BEACON_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  //                  { "name": "SIGNIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }]
}
